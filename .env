# Archivo de variables de entorno para tu ecommerce

# === Desarrollo: Base de Datos ===
MYSQL_ROOT_PASSWORD=Millonarios_15         # Contraseña de root de MariaDB
MYSQL_DATABASE=infosoluciones              # Nombre de la base de datos de WordPress
MYSQL_USER=jeremias                        # Usuario de la base de datos
MYSQL_PASSWORD=Millonarios_15              # Contraseña del usuario de la base de datos

# === Desarrollo: Configuración de WordPress ===
WORDPRESS_DB_HOST=db:3306                  # Host de la base de datos (no cambiar si es docker)
WORDPRESS_DB_NAME=infosoluciones           # Igual a MYSQL_DATABASE
WORDPRESS_DB_USER=jeremias                 # Igual a MYSQL_USER
WORDPRESS_DB_PASSWORD=Millonarios_15       # Igual a MYSQL_PASSWORD
WORDPRESS_TABLE_PREFIX=wp_                 # Prefijo para tablas de WordPress
SITE_URL="http://localhost"                # URL base de tu sitio (ajustada a entorno local)
